eData_Home":4,"fetchSpotlightCards_Home":63,"fetchArticleData_Home":128,"fetchPlaylistsData_Home_v2":428,"fetchMixesData_Home_v2":1391,"fetchAlbumsData_Home_v2":2979,"fetchSinglesData_Home_v2":4751,"fetchVenuesData_Home_v2":6944,"fetchItemsData-channels":10621},{"data":5,"meta":62},{"id":6,"attributes":7},1,{"heroText":8,"heroButtonText":8,"body":9,"subText":8,"heroLink":8,"createdAt":10,"updatedAt":11,"publishedAt":12,"heroVideoUrl":8,"heroImage":13,"seoImage":61},null,"Café del Mar is a globally recognised music lifestyle brand, founded in Ibiza in 1980. Known for pioneering the chillout movement, its iconic Ibiza venue remains a symbol of the island’s most authentic sunset experience.\n\nThe brand has since evolved into an international presence, with a critically acclaimed music label and a growing portfolio of beach clubs around the world.","2025-05-12T19:44:48.336Z","2026-07-27T00:05:53.922Z","2025-05-12T19:44:49.546Z",{"data":14},{"id":15,"attributes":16},393,{"name":17,"alternativeText":8,"caption":8,"width":18,"height":19,"formats":20,"hash":54,"ext":22,"mime":25,"size":55,"url":56,"previewUrl":8,"provider":57,"provider_metadata":58,"createdAt":60,"updatedAt":60},"65879764_886115965084444_8768089710884028416_n-1.png",2048,1365,{"large":21,"small":31,"medium":39,"thumbnail":46},{"ext":22,"url":23,"hash":24,"mime":25,"name":26,"path":8,"size":27,"width":28,"height":29,"provider_metadata":30},".png","https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_65879764_886115965084444_8768089710884028416_n_1_f051784f8c/public","large_65879764_886115965084444_8768089710884028416_n_1_f051784f8c","image/png","large_65879764_886115965084444_8768089710884028416_n-1.png",967.97,1000,667,{"public_id":24,"resource_type":24},{"ext":22,"url":32,"hash":33,"mime":25,"name":34,"path":8,"size":35,"width":36,"height":37,"provider_metadata":38},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_65879764_886115965084444_8768089710884028416_n_1_f051784f8c/public","small_65879764_886115965084444_8768089710884028416_n_1_f051784f8c","small_65879764_886115965084444_8768089710884028416_n-1.png",265.53,500,333,{"public_id":33,"resource_type":33},{"ext":22,"url":40,"hash":41,"mime":25,"name":42,"path":8,"size":43,"width":44,"height":36,"provider_metadata":45},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_65879764_886115965084444_8768089710884028416_n_1_f051784f8c/public","medium_65879764_886115965084444_8768089710884028416_n_1_f051784f8c","medium_65879764_886115965084444_8768089710884028416_n-1.png",556.97,750,{"public_id":41,"resource_type":41},{"ext":22,"url":47,"hash":48,"mime":25,"name":49,"path":8,"size":50,"width":51,"height":52,"provider_metadata":53},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_65879764_886115965084444_8768089710884028416_n_1_f051784f8c/public","thumbnail_65879764_886115965084444_8768089710884028416_n_1_f051784f8c","thumbnail_65879764_886115965084444_8768089710884028416_n-1.png",67.09,234,156,{"public_id":48,"resource_type":48},"65879764_886115965084444_8768089710884028416_n_1_f051784f8c",814.09,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/65879764_886115965084444_8768089710884028416_n_1_f051784f8c/public","strapi-provider-upload-cloudflare",{"public_id":54,"resource_type":59},"optimized-65879764_886115965084444_8768089710884028416_n_1_f051784f8c","2026-07-27T00:05:49.407Z",{"data":8},{},{"data":64,"meta":125},[65],{"id":66,"attributes":67},2,{"name":68,"link":69,"snipped":70,"cta":71,"createdAt":72,"updatedAt":73,"publishedAt":74,"image":75},"Café del Mar Classical","/classical","Café del Mar Classical is the brand-new orchestral show from the iconic international dance music brand, and the undisputed home of chill-out music.","Tour Dates","2026-08-11T02:46:53.301Z","2026-08-11T02:46:54.877Z","2026-08-11T02:46:54.840Z",{"data":76},{"id":77,"attributes":78},497,{"name":79,"alternativeText":8,"caption":8,"width":80,"height":81,"formats":82,"hash":118,"ext":84,"mime":87,"size":119,"url":120,"previewUrl":8,"provider":121,"provider_metadata":122,"createdAt":124,"updatedAt":124},"CafedelMar Social BAN_05.jpg",4000,2250,{"large":83,"small":93,"medium":101,"thumbnail":109},{"ext":84,"url":85,"hash":86,"mime":87,"name":88,"path":8,"size":89,"width":28,"height":90,"provider_metadata":91},".jpg","https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/3c774196-9edc-4677-cc6e-61c1dbe31c00/public","large_Cafedel_Mar_Social_BAN_05_fcc292af3e","image/jpeg","large_CafedelMar Social BAN_05.jpg",72.98,563,{"cfImageId":92},"3c774196-9edc-4677-cc6e-61c1dbe31c00",{"ext":84,"url":94,"hash":95,"mime":87,"name":96,"path":8,"size":97,"width":36,"height":98,"provider_metadata":99},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/63d6c062-f424-44dd-88f5-6e9d3a315d00/public","small_Cafedel_Mar_Social_BAN_05_fcc292af3e","small_CafedelMar Social BAN_05.jpg",20.14,281,{"cfImageId":100},"63d6c062-f424-44dd-88f5-6e9d3a315d00",{"ext":84,"url":102,"hash":103,"mime":87,"name":104,"path":8,"size":105,"width":44,"height":106,"provider_metadata":107},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/3608040d-aa96-4d7a-490f-92236d30dd00/public","medium_Cafedel_Mar_Social_BAN_05_fcc292af3e","medium_CafedelMar Social BAN_05.jpg",42.18,422,{"cfImageId":108},"3608040d-aa96-4d7a-490f-92236d30dd00",{"ext":84,"url":110,"hash":111,"mime":87,"name":112,"path":8,"size":113,"width":114,"height":115,"provider_metadata":116},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/1d757421-5a8d-4056-ab68-703e34a91d00/public","thumbnail_Cafedel_Mar_Social_BAN_05_fcc292af3e","thumbnail_CafedelMar Social BAN_05.jpg",6.02,245,138,{"cfImageId":117},"1d757421-5a8d-4056-ab68-703e34a91d00","Cafedel_Mar_Social_BAN_05_fcc292af3e",789.99,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/10876add-c9ef-435b-31c7-06b6caff8000/public","/workspace/providers/strapi-provider-upload-cf-dual",{"cfImageId":123},"10876add-c9ef-435b-31c7-06b6caff8000","2026-08-11T02:45:50.968Z",{"pagination":126},{"page":6,"pageSize":127,"pageCount":6,"total":6},25,{"data":129,"meta":424},[130,187,250,308,367],{"id":131,"attributes":132},5,{"featured":133,"name":134,"body":135,"snipped":136,"slug":137,"linkText":8,"linkUrl":8,"releaseDate":138,"large":133,"inlay":8,"visible":133,"createdAt":139,"updatedAt":140,"publishedAt":141,"image":142,"type":184,"radio_category":185,"dynamicField":186},true,"Café del Mar unveils new Beach Club at VR Shekvetili Forest–Beach","For the first time, the iconic spirit of Ibiza finds a new home in Shekvetili, where music,\nsunsets, and timeless atmosphere come together in a truly unique setting.\n\n![804A3723.jpg](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/804_A3723_1c65879dcf/public)\n\nThe venue is part of the **VR Shekvetili Forest–Beach Project**, a premium investment and\nresidential development located between the seaside and a natural pine forest. The project is\ndesigned to combine modern living with a peaceful natural environment, offering both comfortable\nresidences and long-term investment value.\n\n![DJI_0478.jpg](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/DJI_0478_8c22595e51/public)\n\nWithin this development, Café del Mar Beach Club will serve as a key lifestyle destination. It will\noffer a calm and elegant setting, accompanied by the brand’s signature music and atmosphere.\nThe beach club will feature a high-quality food and beverage experience, professional service, and a\ncarefully designed space for relaxation and social gatherings.\n\n![DJI_0494.jpg](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/DJI_0494_5a20d4b473/public)\n\nCafé del Mar Shekvetili represents a new chapter for the brand, bringing its well-known identity to a\ngrowing destination on the Black Sea.","Café del Mar is proud to announce an exciting new chapter - our arrival on the Black Sea coast of\nGeorgia.","cafe-del-mar-unveils-new-beach-club-at-vr-shekvetili-forest-beach","2026-03-17T23:00:00.000Z","2026-03-18T20:01:29.623Z","2026-03-18T20:04:12.048Z","2026-03-18T20:01:31.730Z",{"data":143},{"id":144,"attributes":145},291,{"name":146,"alternativeText":8,"caption":8,"width":147,"height":148,"formats":149,"hash":178,"ext":84,"mime":87,"size":179,"url":180,"previewUrl":8,"provider":57,"provider_metadata":181,"createdAt":183,"updatedAt":183},"804A0781 копияფ.jpg",5433,3579,{"large":150,"small":157,"medium":164,"thumbnail":171},{"ext":84,"url":151,"hash":152,"mime":87,"name":153,"path":8,"size":154,"width":28,"height":155,"provider_metadata":156},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_804_A0781_kopiyaph_32438ee297/public","large_804_A0781_kopiyaph_32438ee297","large_804A0781 копияფ.jpg",136.05,658,{"public_id":152,"resource_type":152},{"ext":84,"url":158,"hash":159,"mime":87,"name":160,"path":8,"size":161,"width":36,"height":162,"provider_metadata":163},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_804_A0781_kopiyaph_32438ee297/public","small_804_A0781_kopiyaph_32438ee297","small_804A0781 копияფ.jpg",40.48,329,{"public_id":159,"resource_type":159},{"ext":84,"url":165,"hash":166,"mime":87,"name":167,"path":8,"size":168,"width":44,"height":169,"provider_metadata":170},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_804_A0781_kopiyaph_32438ee297/public","medium_804_A0781_kopiyaph_32438ee297","medium_804A0781 копияფ.jpg",82.47,494,{"public_id":166,"resource_type":166},{"ext":84,"url":172,"hash":173,"mime":87,"name":174,"path":8,"size":175,"width":176,"height":52,"provider_metadata":177},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_804_A0781_kopiyaph_32438ee297/public","thumbnail_804_A0781_kopiyaph_32438ee297","thumbnail_804A0781 копияფ.jpg",11.06,237,{"public_id":173,"resource_type":173},"804_A0781_kopiyaph_32438ee297",1439.14,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/804_A0781_kopiyaph_32438ee297/public",{"public_id":178,"resource_type":182},"upload_a8b683b98ed7fb4f3e4d4660649c8356","2026-03-18T20:00:00.211Z",{"data":8},{"data":8},[],{"id":188,"attributes":189},4,{"featured":133,"name":190,"body":191,"snipped":192,"slug":193,"linkText":8,"linkUrl":8,"releaseDate":194,"large":133,"inlay":8,"visible":133,"createdAt":195,"updatedAt":196,"publishedAt":197,"image":198,"type":240,"radio_category":248,"dynamicField":249},"Café del Mar Phuket Launches New On-Site Suites","\nCafé del Mar Phuket is expanding beyond the beach club scene with the launch of the Café del Mar Phuket Suites. This move marks a shift from a beach club destination to a full-service hospitality venue, allowing guests to stay on-site in five-star accommodations designed for both privacy and hosting.\n\nWhile Café del Mar Phuket is known for its daytime poolside sessions and club nights hosted by international superstar DJs, these new suites bridge the gap between the energy of the club and the relaxation of a high-end resort. This local expansion reflects a wider direction for the global Café del Mar brand as it moves further into the lifestyle and hospitality sector.\n\nThe New Suite Collection\n\n![v12.jpg](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/v12_b6d50a7b70/public)\n**Suite 100 sqm | 2 Adults**\nThis expansive one-bedroom escape features an opulent living area, a private bathtub with a stunning sky view, and a plunge pool. The experience is elevated by a sunset seating deck, offering captivating sea views of Kamala Beach and the lively atmosphere of Café del Mar Phuket.\n\n\n\n![s1.jpg](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/s1_010b768925/public)\n**VIP Suite 146 sqm | 2 Adults**\nThe VIP Suite features an opulent lounge, a mini garden with a cozy hammock, and sky views. Guests can enjoy ultimate comfort in a luxurious bedroom, a spacious bathtub, and a private plunge pool. The terrace provides a space to experience stunning sunsets and breathtaking beachside views, with exclusive access to the beach club’s live music events.\n\n\n\n![Penthouse-10.jpg](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/Penthouse_10_686fed1032/public)\n**The Penthouse 278 sqm | 4 Adults**\nFeaturing a stylish 12-seat dining table, a fully equipped BBQ station, an expansive lounge, and a large terrace, this two-bedroom penthouse is designed for both relaxation and hosting private parties. Guests enjoy exclusive access and special benefits throughout their stay at Café del Mar Beach Club.\n\n\n\n>We wanted to give people a way to stay in the vibe of Café del Mar without having to leave at the end of the night,\" the Phuket team explains. \"By adding these suites, we are moving from a beach club to a destination where the music, the food, and the room are all part of the same experience.\n\n\n**Global Brand Growth**\n\nThis expansion in Phuket is a key part of the global Café del Mar strategy to grow into the hospitality and resort market. By moving into high-end accommodations, the brand is evolving from its roots as an Ibiza themed beach clubs to target premium guests with a 360-degree service experience.\n\n**About Café del Mar Phuket**\n\nLocated on Kamala Beach, Café del Mar Phuket was voted #45 in DJ Mag's Top 100 Clubs list for 2025. In recent years, it has hosted nearly all top international DJs, from Solomun to Bonobo and Black Coffee to Fisher. It is part of the global Café del Mar network, which has been a leading chillout brand since 1980.","Café del Mar Phuket is taking the beach club experience to the next level with the launch of the Café del Mar Phuket Suites. Known for having the best beach parties in Phuket, the venue now offers guests a way to keep the vibe going in their own private, five-star space.","cafe-del-mar-phuket-launches-new-on-site-suites","2025-12-31T23:00:00.000Z","2026-01-12T01:43:05.182Z","2026-01-12T02:08:22.977Z","2026-01-12T02:01:45.444Z",{"data":199},{"id":200,"attributes":201},285,{"name":202,"alternativeText":8,"caption":8,"width":203,"height":204,"formats":205,"hash":234,"ext":84,"mime":87,"size":235,"url":236,"previewUrl":8,"provider":57,"provider_metadata":237,"createdAt":239,"updatedAt":239},"Penthouse-10.jpg",2560,1809,{"large":206,"small":213,"medium":220,"thumbnail":227},{"ext":84,"url":207,"hash":208,"mime":87,"name":209,"path":8,"size":210,"width":28,"height":211,"provider_metadata":212},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_Penthouse_10_686fed1032/public","large_Penthouse_10_686fed1032","large_Penthouse-10.jpg",145.17,707,{"public_id":208,"resource_type":208},{"ext":84,"url":214,"hash":215,"mime":87,"name":216,"path":8,"size":217,"width":36,"height":218,"provider_metadata":219},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_Penthouse_10_686fed1032/public","small_Penthouse_10_686fed1032","small_Penthouse-10.jpg",40.91,353,{"public_id":215,"resource_type":215},{"ext":84,"url":221,"hash":222,"mime":87,"name":223,"path":8,"size":224,"width":44,"height":225,"provider_metadata":226},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_Penthouse_10_686fed1032/public","medium_Penthouse_10_686fed1032","medium_Penthouse-10.jpg",86.25,530,{"public_id":222,"resource_type":222},{"ext":84,"url":228,"hash":229,"mime":87,"name":230,"path":8,"size":231,"width":232,"height":52,"provider_metadata":233},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_Penthouse_10_686fed1032/public","thumbnail_Penthouse_10_686fed1032","thumbnail_Penthouse-10.jpg",9.63,221,{"public_id":229,"resource_type":229},"Penthouse_10_686fed1032",726.44,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/Penthouse_10_686fed1032/public",{"public_id":234,"resource_type":238},"optimized-Penthouse_10_686fed1032","2026-01-12T01:45:28.685Z",{"data":241},{"id":242,"attributes":243},3,{"name":244,"createdAt":245,"updatedAt":246,"publishedAt":247},"venues","2025-05-21T20:57:19.980Z","2025-05-21T20:57:20.963Z","2025-05-21T20:57:20.956Z",{"data":8},[],{"id":242,"attributes":251},{"featured":133,"name":252,"body":253,"snipped":254,"slug":255,"linkText":8,"linkUrl":8,"releaseDate":256,"large":133,"inlay":8,"visible":133,"createdAt":257,"updatedAt":258,"publishedAt":259,"image":260,"type":299,"radio_category":306,"dynamicField":307},"Café del Mar Launches First Artist Album With Legendary Electronic Duo Pig&Dan","Globally recognised for defining the chillout and Balearic sound, Café del Mar is renowned for curating captivating sunset experiences and compilations, shaping decades of musical culture far beyond the Balearics where it was born. Now celebrating their 45th anniversary, the revered Ibiza brand embraces a forward-thinking persona, expanding on their formative roots. This new format sets to elevate their legacy through a collaborative vision, starting with Pig&Dan's‘ Journey Within’. This milestone sets a precedent for artist-led projects under Café del Mar Music, pushing boundaries whilst still honouring its sunset heritage.\n\nCafé del Mar’s resident DJ & Music Curator, Ken Fan, echoes the release's sentiment \n\n![0R2A2659.jpg](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/0_R2_A2659_1ecebe1f8d/public)\n\n>\"Pig&Dan sent me this unsigned album last year, and after testing the tracks in my daily sets, the crowd’s reaction said it all. Every time I included them in a mix, people were asking what they were, and Shazaming with no results. It’s a brilliant start to our first artist release at Café del Mar, with more to come. Watch this space.\"\n\nFor Pig&Dan, Journey Within marks an artistic evolution. Broadly known for their high-energy Techno sets on worldwide stages that include Tomorrowland and Awakenings, the creative duo pivots into a more reflective side of their identity with this compilation. The album roots itself into earthy dub textures, featuring warm psychedelia and downtempo soundscapes that create an expansive reimagining of chillout music, anchored with raw depth and emotion.\n\nPig&Dan share their insights and inspiration \n\n![public](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/public_393f850e06/public)\n\n>“We wanted to explore the deeper, more emotive side of our musical identity, stepping away from the club energy to create something that reaches a bit deeper. This album is a journey into our minds, reflecting the influences and organic sounds that have always been part of our creative DNA.” \n\nThe album is both evolutionary and explorative in equal measure. With a well-curated mix of tracks and emotions, listeners will be drawn into a journey that amplifies the Ibiza vibe. The first track is a prime example, ‘Can’t Do It On My Own’ instantly sets the album’s soul-searching tone. Built upon rich, layered instrumentation, the track weaves emotive strings and atmospheric synths before breaking into an expressive vocal, elevating the track’s introspective feel. It’s a standout production that bridges Pig&Dan’s underground credibility with Café del Mar’s resilient and emotive storytelling.\n\nThis milestone release not only honours Café del Mar’s Balearic heritage, synonymous with chillout and Ibiza’s golden-hour spirit, but also signals a visionary future for the label. With stunning cover art by David Robles, Journey Within captures a deeply personal and forward-thinking sound, setting the tone for a new era of artist-led storytelling under Café del Mar Music.\n\nJourney Within will be available June 13th, 2025, on all major streaming platforms. \n\n[Presave ](https://li.sten.to/journeywithin)\n\n\n![public](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/public_c2da7589b4/public)\n\n01. Can’t Do it on My Own\n02. Let it Slide\n03. Freedom is a State of Mind\n04. Got a Lot to Live for\n05. Hold the Money\n06. Blowback\n07. I Feel it\n08. Keep My Thoughts Behind\n09. Fly Through the Sky\n10. The Path to Kasbah\n11. 4 Lanes\n12. Ready fo Dem\n","Marking a bold new chapter in their enduring legacy, Café del Mar sets to release its first-ever artist-led album ‘Journey Within’ crafted by electronic heavyweights Pig&Dan. Released on June 13th, 2025, the album represents an exciting genre shift for both artist and label, fusing Pig&Dan’s signature techno-edged soundtrack with the icon, laid-back, immersive ethos of Café del Mar’s chillout heritage.","cafe-del-mar-launches-first-artist-album-with-legendary-electronic-duo-pig-and-dan","2025-06-01T22:00:00.000Z","2025-06-02T20:00:03.688Z","2025-06-02T21:48:38.361Z","2025-06-02T20:00:07.384Z",{"data":261},{"id":262,"attributes":263},218,{"name":264,"alternativeText":8,"caption":8,"width":265,"height":266,"formats":267,"hash":293,"ext":84,"mime":87,"size":294,"url":295,"previewUrl":8,"provider":57,"provider_metadata":296,"createdAt":298,"updatedAt":298},"180821_PIG&DAN_JCV6722.jpg",6000,4005,{"large":268,"small":274,"medium":280,"thumbnail":287},{"ext":84,"url":269,"hash":270,"mime":87,"name":271,"path":8,"size":272,"width":28,"height":29,"provider_metadata":273},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_180821_PIG_and_DAN_JCV_6722_74c1262946/public","large_180821_PIG_and_DAN_JCV_6722_74c1262946","large_180821_PIG&DAN_JCV6722.jpg",28.86,{"public_id":270,"resource_type":270},{"ext":84,"url":275,"hash":276,"mime":87,"name":277,"path":8,"size":278,"width":36,"height":37,"provider_metadata":279},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_180821_PIG_and_DAN_JCV_6722_74c1262946/public","small_180821_PIG_and_DAN_JCV_6722_74c1262946","small_180821_PIG&DAN_JCV6722.jpg",9.77,{"public_id":276,"resource_type":276},{"ext":84,"url":281,"hash":282,"mime":87,"name":283,"path":8,"size":284,"width":44,"height":285,"provider_metadata":286},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_180821_PIG_and_DAN_JCV_6722_74c1262946/public","medium_180821_PIG_and_DAN_JCV_6722_74c1262946","medium_180821_PIG&DAN_JCV6722.jpg",18.14,501,{"public_id":282,"resource_type":282},{"ext":84,"url":288,"hash":289,"mime":87,"name":290,"path":8,"size":291,"width":51,"height":52,"provider_metadata":292},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_180821_PIG_and_DAN_JCV_6722_74c1262946/public","thumbnail_180821_PIG_and_DAN_JCV_6722_74c1262946","thumbnail_180821_PIG&DAN_JCV6722.jpg",3.29,{"public_id":289,"resource_type":289},"180821_PIG_and_DAN_JCV_6722_74c1262946",750.25,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/180821_PIG_and_DAN_JCV_6722_74c1262946/public",{"public_id":293,"resource_type":297},"optimized-180821_PIG_and_DAN_JCV_6722_74c1262946","2025-06-02T19:52:22.226Z",{"data":300},{"id":66,"attributes":301},{"name":302,"createdAt":303,"updatedAt":304,"publishedAt":305},"music","2025-05-12T22:25:40.217Z","2025-05-13T12:02:44.481Z","2025-05-12T22:25:41.267Z",{"data":8},[],{"id":6,"attributes":309},{"featured":133,"name":310,"body":311,"snipped":312,"slug":313,"linkText":8,"linkUrl":8,"releaseDate":314,"large":133,"inlay":315,"visible":133,"createdAt":316,"updatedAt":317,"publishedAt":318,"image":319,"type":358,"radio_category":365,"dynamicField":366},"Café del Mar Celebrates 45 Years Of Iconic Sunsets ","A globally recognised institution known for capturing the spirit of the island through sunset sessions, iconic events, mediterranean vibes, and world-renowned chillout sound, Café del Mar is synonymous with the Ibiza lifestyle. In a new era, the lifestyle brand is set to explore a refreshed identity centered on an impressive refurb and refined food and drink expereince, featuring a new kitchen and an expansion of their signature [Spirits](https://spirits.cafedelmar.com) line. \n\n![public](https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/public_5ec2acac9c/public)\n\nStepping into this year's season, Café del Mar is set to evolve. While staying true to its legendary  essence, they’re bringing a deeper focus on Ibizan roots and a spotlight on post sunset parties, resident DJs, promoters, and the labels defining the island. Anticipate carefully curated lineups, exclusive events, and collaborations, with Marco Loco, Centrl Ofc, and Andy Wilson already announced. \n\nTo kick start the anniversary celebrations, Café del Mar released the fifth volume of their infamous Chill Out Mix earlier this year. Highlighting the 45th year, a special anniversary compilation of 30 tracks is also set for release, featuring legends like Frankie Knuckles, Aphex Twin, Röyksopp, Derrick May, Todd Terje, Moby, and Gerald. With more releases on the horizon, fans can look forward to a fresh set of mixes and their new artist album series, kicking off with Pig&Dan on June 13th.\n\nThe venue also welcomes Ibiza's first ever installment of the legendary Elara.6 mixer, contributing to an unparalleled booth and sound. Headed up by infamous audio engineer and mixer designer Andy Rigby-Jones, the pioneer of the Master Sounds and Allen & Heath Xone series, the mixer is a celebrated leader in the industry. Offering solid construction, enhanced workflows, and top quality sound, visitors will experience an elevated and unforgettable listening journey this summer.\n\n\nSet to launch in June, in a new wave of innovation, the venue welcomes Chef Nina, offering a refreshed menu curation. As Ibiza continues to evolve as a champion destination of lifestyle, music, and culture, food remains a central thread in the island’s vibrant landscape. This next chapter promises to deepen their creative flair and offer a dining experience unlike any other. \n\n**Music Manager and resident DJ Ken Fan comments:** \n\n>We’re incredibly excited to be reopening Café del Mar this summer season and, most importantly, to be celebrating 45 years as an institution on the island. From pioneering the Balearic sound to releasing one of the most beloved chill-out compilation series in the world, we’ve been the backdrop to countless sunsets, memories, and musical journeys - and the story continues this season.\n\nFor the last 45 years, Café del Mar has been a sanctuary for sunset seekers in Ibiza. Founded in 1980 on the San Antonio coastline, the imprint birthed a musical movement defining balearic chillout, placing Ibiza on the cultural map as much for its style as for its nightlife. Now a resident brand across Spain and Thailand, Café del Mar has cemented itself as a cultural hotspot. \n\n**With a historic season of parties, dining, and summer sun set, 2025 stands as a living testament to the enduring legacy of Café del Mar.**","Marking 45 years on the Balearic Island, Café del Mar Ibiza reopens this season with a new look, a refreshed sound, an innovative culinary offering, and a special anniversary compilation celebrating its iconic musical legacy.\n","cafe-del-mar-celebrates-45-years-of-iconic-sunsets","2025-05-27T22:00:00.000Z",false,"2025-05-12T22:25:15.044Z","2025-05-12T22:28:23.266Z","2025-05-12T22:25:16.331Z",{"data":320},{"id":321,"attributes":322},17,{"name":323,"alternativeText":8,"caption":8,"width":324,"height":325,"formats":326,"hash":352,"ext":328,"mime":87,"size":353,"url":354,"previewUrl":8,"provider":57,"provider_metadata":355,"createdAt":357,"updatedAt":357},"public",1152,768,{"large":327,"small":334,"medium":340,"thumbnail":346},{"ext":328,"url":329,"hash":330,"mime":87,"name":331,"path":8,"size":332,"width":28,"height":29,"provider_metadata":333},".jpeg","https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_public_2e27bf88c3/public","large_public_2e27bf88c3","large_public",108.41,{"public_id":330,"resource_type":330},{"ext":328,"url":335,"hash":336,"mime":87,"name":337,"path":8,"size":338,"width":36,"height":37,"provider_metadata":339},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_public_2e27bf88c3/public","small_public_2e27bf88c3","small_public",38.62,{"public_id":336,"resource_type":336},{"ext":328,"url":341,"hash":342,"mime":87,"name":343,"path":8,"size":344,"width":44,"height":36,"provider_metadata":345},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_public_2e27bf88c3/public","medium_public_2e27bf88c3","medium_public",71.84,{"public_id":342,"resource_type":342},{"ext":328,"url":347,"hash":348,"mime":87,"name":349,"path":8,"size":350,"width":51,"height":52,"provider_metadata":351},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_public_2e27bf88c3/public","thumbnail_public_2e27bf88c3","thumbnail_public",11.63,{"public_id":348,"resource_type":348},"public_2e27bf88c3",126.2,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/public_2e27bf88c3/public",{"public_id":352,"resource_type":356},"optimized-public_2e27bf88c3","2025-05-12T22:26:12.939Z",{"data":359},{"id":6,"attributes":360},{"name":361,"createdAt":362,"updatedAt":363,"publishedAt":364},"ibiza","2025-05-12T22:25:32.204Z","2025-05-13T12:02:37.486Z","2025-05-12T22:25:33.120Z",{"data":8},[],{"id":66,"attributes":368},{"featured":133,"name":369,"body":370,"snipped":371,"slug":372,"linkText":8,"linkUrl":8,"releaseDate":373,"large":133,"inlay":315,"visible":133,"createdAt":374,"updatedAt":375,"publishedAt":376,"image":377,"type":419,"radio_category":422,"dynamicField":423},"Café del Mar Phuket voted #45 in DJ Mag Top 100 Clubs","The new ranking is 25 positions up compared to last year's results.\n\n>This achievement isn’t just a ranking; it’s proof of the passion, energy, and commitment from our dedicated team, incredible artists, and amazing customers who make every moment here unforgettable. We are grateful to everyone who’s supported us, believed in us, and helped us grow. Here’s to celebrating this milestone together and to many more ahead.\n\nBy blending dreamy tropical auras with modern luxury design, Café Del Mar Phuket offers three distinct experiences for electronic thrillseekers. The Pyramid-stage can accommodate up to 3,000 revellers for special events where its pool is covered, offering a festival-like atmosphere when Solomun, Francis Mercier or Peggy Gou come through town. Elsewhere, the 1,000-cap Temple Stage and a more intimate indoor (and newly-renovated) club room ensure parties of all sizes. 2024 welcomed new levels of extravagance for the venue with the launch of VIP penthouse hotel rooms and enhancements to the existing D&B and L-Acoustics sound system and advanced LiveFRAME design lighting, resulting in an elevated attendee experience that retains Café Del Mar’s signature island ambiance.","Café del Mar Phuket has been voted at top 45 in this year's DJ Mag's Top 100 Clubs ranking","cafe-del-mar-phuket-voted-45-in-dj-mag-top-100-clubs-in-2025","2025-05-19T22:00:00.000Z","2025-05-21T20:56:59.053Z","2025-05-21T21:18:52.056Z","2025-05-21T20:57:39.971Z",{"data":378},{"id":379,"attributes":380},194,{"name":381,"alternativeText":8,"caption":8,"width":382,"height":383,"formats":384,"hash":413,"ext":84,"mime":87,"size":414,"url":415,"previewUrl":8,"provider":57,"provider_metadata":416,"createdAt":418,"updatedAt":418},"495489232_18383524561140506_7725140042948740919_n.jpg",1440,1799,{"large":385,"small":392,"medium":399,"thumbnail":406},{"ext":84,"url":386,"hash":387,"mime":87,"name":388,"path":8,"size":389,"width":28,"height":390,"provider_metadata":391},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_495489232_18383524561140506_7725140042948740919_n_caa66e78b9/public","large_495489232_18383524561140506_7725140042948740919_n_caa66e78b9","large_495489232_18383524561140506_7725140042948740919_n.jpg",297.75,1249,{"public_id":387,"resource_type":387},{"ext":84,"url":393,"hash":394,"mime":87,"name":395,"path":8,"size":396,"width":36,"height":397,"provider_metadata":398},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_495489232_18383524561140506_7725140042948740919_n_caa66e78b9/public","small_495489232_18383524561140506_7725140042948740919_n_caa66e78b9","small_495489232_18383524561140506_7725140042948740919_n.jpg",81.15,625,{"public_id":394,"resource_type":394},{"ext":84,"url":400,"hash":401,"mime":87,"name":402,"path":8,"size":403,"width":44,"height":404,"provider_metadata":405},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_495489232_18383524561140506_7725140042948740919_n_caa66e78b9/public","medium_495489232_18383524561140506_7725140042948740919_n_caa66e78b9","medium_495489232_18383524561140506_7725140042948740919_n.jpg",171.33,937,{"public_id":401,"resource_type":401},{"ext":84,"url":407,"hash":408,"mime":87,"name":409,"path":8,"size":410,"width":411,"height":52,"provider_metadata":412},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_495489232_18383524561140506_7725140042948740919_n_caa66e78b9/public","thumbnail_495489232_18383524561140506_7725140042948740919_n_caa66e78b9","thumbnail_495489232_18383524561140506_7725140042948740919_n.jpg",7.25,125,{"public_id":408,"resource_type":408},"495489232_18383524561140506_7725140042948740919_n_caa66e78b9",571.66,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/495489232_18383524561140506_7725140042948740919_n_caa66e78b9/public",{"public_id":413,"resource_type":417},"optimized-495489232_18383524561140506_7725140042948740919_n_caa66e78b9","2025-05-21T20:55:41.865Z",{"data":420},{"id":242,"attributes":421},{"name":244,"createdAt":245,"updatedAt":246,"publishedAt":247},{"data":8},[],{"pagination":425},{"start":426,"limit":427,"total":131},0,6,{"data":429,"meta":1388},[430,497,1158,1216,1274,1333],{"id":431,"attributes":432},49,{"availableDate":433,"name":434,"lenght":8,"slug":435,"spotifyId":436,"metadata":437,"appOnly":8,"memberOnly":8,"audioUrl":8,"releaseDate":438,"featured":133,"status":8,"linkUrl":439,"description":440,"createdAt":441,"updatedAt":442,"publishedAt":443,"onDemand":8,"onDemandUrl":8,"highlight":133,"image":444,"type":482,"portals":489,"artist":495,"series":496},"2026-01-07T23:00:00.000Z","Ibiza Chillout","ibiza-chillout","6H2OZzeoaIdgL17NoF6jD5",[],"2023-04-28T00:00:00.000Z","https://cafedelmar.ffm.to/ibizaplaylist","Best Ibiza chillout, ambient, downtempo and lounge tracks from 2025 and classics from the past","2024-04-28T14:42:40.352Z","2026-01-09T18:20:52.315Z","2024-04-28T14:42:40.345Z",{"data":445},{"id":446,"attributes":447},83,{"name":448,"alternativeText":449,"caption":449,"width":450,"height":450,"formats":451,"hash":476,"ext":84,"mime":87,"size":477,"url":478,"previewUrl":8,"provider":57,"provider_metadata":479,"createdAt":481,"updatedAt":481},"ibiza.jpg","",1500,{"large":452,"small":458,"medi