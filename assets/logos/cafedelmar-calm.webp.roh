fedelmartarifa.com",{"id":188,"seasonStart":10270,"seasonEnd":10271,"reservationUrl":10454,"image":10455},"https://www.cafedelmarbeach.com/es/beach-tarifa/",{"data":8},[],[],[],[],{"id":131,"windSpeed":10461,"windDeg":8,"sunsetTime":10462,"sunriseTime":10463,"temperature":10307},1.54,"20:07","06:09",{"data":8},[],{"data":8},{"data":10468},[],{"id":427,"attributes":10470},{"name":10471,"description":10472,"videoUrl":8,"about":8,"slug":10473,"createdAt":10474,"updatedAt":10475,"publishedAt":10476,"heroVideoUrl":8,"availableDate":10477,"locale":6956,"image":10478,"type":10513,"address":10520,"essentials":10529,"hours":10532,"spotlight":10533,"faq":10534,"reservationArea":10535,"sectionImages":8,"weather":10536,"video":10539,"stories":10540,"gallery":10541,"localizations":10542},"Meloneras","Café del Mar Meloneras opened in 2015 with the concept of creating a cabaret dinner experience, as well as offering a variety of drinks against the backdrop of a lovely sunset. \n\nThe idea was to create a unique and special concept in Gran Canaria by offering both food and drinks accompanied by a live music experience in the open air, making the most of the enjoyable weather. \n\nMoreover, after the show, the venue features some of the best DJs on the island, who play late into the night to create a fun and unforgettable experience.","meloneras","2025-05-19T16:19:36.006Z","2025-08-01T21:52:24.423Z","2025-05-19T16:19:38.242Z","2025-05-05T22:00:00.000Z",{"data":10479},{"id":10480,"attributes":10481},191,{"name":10482,"alternativeText":8,"caption":8,"width":382,"height":10102,"formats":10483,"hash":10507,"ext":84,"mime":87,"size":10508,"url":10509,"previewUrl":8,"provider":57,"provider_metadata":10510,"createdAt":10512,"updatedAt":10512},"46bea0e786c422d1e5ba24692f9e4394_80c4d2a0e4.jpg",{"large":10484,"small":10489,"medium":10495,"thumbnail":10501},{"ext":84,"url":10485,"hash":10486,"mime":87,"name":10487,"path":8,"size":4955,"width":28,"height":29,"provider_metadata":10488},"https://