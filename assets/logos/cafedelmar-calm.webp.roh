2025-05-19T10:22:03.677Z","2024-03-18T01:13:16.214Z",{"id":131,"street":10521,"phone":10522,"email":10523,"postal":8,"country":7008,"city":10524,"latitude":10525,"longitude":10526,"instagram":10527,"facebook":10527,"website":10528},"Plaza del Faro, 3D, 35100 Meloneras","+34 637 884 020","reservas@cafedelmarmeloneras.com","Las Palmas","27.7359367","-15.6006446","cafedelmargc","https://www.cafedelmarmeloneras.com/",{"id":427,"seasonStart":10270,"seasonEnd":10271,"reservationUrl":10530,"image":10531},"https://www.cafedelmarmeloneras.com/reservar/",{"data":8},[],[],[],[],{"id":7071,"windSpeed":7112,"windDeg":8,"sunsetTime":10537,"sunriseTime":10306,"temperature":10538},"21:27","24",{"data":8},[],{"data":8},{"data":10543},[],{"id":131,"attributes":10545},{"name":10546,"description":10547,"videoUrl":8,"about":8,"slug":10548,"createdAt":10549,"updatedAt":10550,"publishedAt":10551,"heroVideoUrl":8,"availableDate":10477,"locale":6956,"image":10552,"type":10587,"address":10594,"essentials":10604,"hours":10606,"spotlight":10607,"faq":10608,"reservationArea":10609,"sectionImages":8,"weather":10610,"video":10614,"stories":10615,"gallery":10616,"localizations":10617},"Tenerife","Effortlessly chic, Rooftop's new bar has style written all over it. Amazing views, an air of luxury and an in-house DJ make Café del Mar one of Tenerife's newest and coolest places to be.\n\nContemporary yet welcoming, Café del Mar invites you to choose from a delicious menu of snacks and light meals as well as a fantastic selection of fresh juices and smoothies, soft drinks, beers, wine, champagne and spirits. Our advice? Head straight for the cocktail menu and you'll get a show as well as a sublime drink as you watch the bartenders put Tom Cruise's cocktail-shaking talents to shame - the mojitos are already legendary. Then sit back, relax and enjoy each other's company in the coolest surroundings imaginable as you listen to the chill out sounds from the in-house DJ.","tenerife","2025-05-19T16:17:45.423Z","2025-08-01T21:52:23.564Z","2025-05-19T16:17:49.074Z",{"data":10553},{"id":10554,"attributes":10555},190,{"name":10556,"alternativeText":8,"caption":8,"width":404,"height":36,"formats":10557,"hash":10581,"ext":5141,"mime":5144,"size":10582,"url":10583,"previewUrl":8,"provider":57,"provider_metadata":10584,"createdAt":10586,"updatedAt":10586},"noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61.webp",{"large":10558,"small":10563,"medium":10569,"thumbnail":10575},{"ext":5141,"url":10559,"hash":10560,"mime":5144,"name":10561,"path":8,"size":6848,"width":28,"height":6731,"provider_metadata":10562},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61_c498b66620/public","large_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61_c498b66620","large_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61.webp",{"public_id":10560,"resource_type":10560},{"ext":5141,"url":10564,"hash":10565,"mime":5144,"name":10566,"path":8,"size":10567,"width":36,"height":2270,"provider_metadata":10568},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61_c498b66620/public","small_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61_c498b66620","small_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61.webp",16.23,{"public_id":10565,"resource_type":10565},{"ext":5141,"url":10570,"hash":10571,"mime":5144,"name":10572,"path":8,"size":10573,"width":44,"height":5550,"provider_metadata":10574},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61_c498b66620/public","medium_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61_c498b66620","medium_noelia_sur_rooftop_02990_jpg_d8076e4addaec480402fbfb24e4dbfff_d3ba57ae61.webp",27.37,{"public_id":10571,"resourc