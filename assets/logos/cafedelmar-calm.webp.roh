data":6935},{"public_id":5050,"resource_type":5050},{"ext":1722,"url":5056,"hash":5057,"mime":87,"name":5058,"path":8,"size":5059,"width":1762,"height":52,"provider_metadata":6937},{"public_id":5057,"resource_type":5057},{"public_id":5061,"resource_type":5065},{"id":66,"instagram":8,"facebook":8,"spotify":8,"apple":8,"bandcamp":8,"website":8,"soundcloud":8,"ra":8},{"data":8},{"pagination":6942},{"start":426,"limit":6943,"total":2510},24,{"data":6945,"meta":10619},[6946,9842,9908,10209,10313,10391,10469,10544],{"id":6,"attributes":6947},{"name":6948,"description":6949,"videoUrl":8,"about":6950,"slug":361,"createdAt":6951,"updatedAt":6952,"publishedAt":6953,"heroVideoUrl":6954,"availableDate":6955,"locale":6956,"image":6957,"type":6996,"address":7003,"essentials":7014,"hours":7059,"spotlight":7078,"faq":7291,"reservationArea":7318,"sectionImages":7777,"weather":8482,"video":8488,"stories":8489,"gallery":9384,"localizations":9834},"Ibiza","Opened on June 20, 1980, Café del Mar has gained iconic status as one of Ibiza's most visited destinations. Situated on the waterfront with views of the enigmatic Sa Conillera, the location provides a spectacular backdrop for experiencing Ibiza's renowned sunset.","Café del Mar was born from a simple idea shared by a group of friends from Zaragoza: to create a soundtrack for the sunset. After discovering the perfect seaside location and spending two years bringing their vision to life—with the help of visionary architect Luis Güell—Café del Mar Ibiza opened its doors on June 20, 1980.\n\nSince then, Café del Mar has become an iconic institution in Ibiza. With its signature sound and breathtaking sunsets, it helped shape the chillout genre and transform it into a global phenomenon.\n\nNearly five decades later, Café del Mar remains true to the original vision that has touched millions of hearts around the world.","2025-05-12T19:55:24.904Z","2026-08-20T14:01:05.375Z","2025-05-12T19:55:33.838Z","https://cdmstrapi4.fra1.cdn.digitaloceanspaces.com/cover_hero_website_2025_new.mp4","2026-03-18T23:00:00.000Z","en",{"data":6958},{"id":6959,"attributes":6960},356,{"name":6961,"alternativeText":8,"caption":8,"width":6213,"height":6962,"formats":6963,"hash":6990,"ext":84,"mime":87,"size":6991,"url":6992,"previewUrl":8,"provider":57,"provider_metadata":6993,"createdAt":6995,"updatedAt":6995},"intro_1.jpg",1350,{"large":6964,"small":6971,"medium":6977,"thumbnail":6984},{"ext":84,"url":6965,"hash":6966,"mime":87,"name":6967,"path":8,"size":6968,"width":28,"height":6969,"provider_metadata":6970},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_intro_1_bcf57cdf11/public","large_intro_1_bcf57cdf11","large_intro_1.jpg",108.86,1250,{"public_id":6966,"resource_type":6966},{"ext":84,"url":6972,"hash":6973,"mime":87,"name":6974,"path":8,"size":6975,"width":36,"height":397,"provider_metadata":6976},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_intro_1_bcf57cdf11/public","small_intro_1_bcf57cdf11","small_intro_1.jpg",38.74,{"public_id":6973,"resource_type":6973},{"ext":84,"url":6978,"hash":6979,"mime":87,"name":6980,"path":8,"size":6981,"width":44,"height":6982,"provider_metadata":6983},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_intro_1_bcf57cdf11/public","medium_intro_1_bcf57cdf11","medium_intro_1.jpg",70.16,938,{"public_id":6979,"resource_type":6979},{"ext":84,"url":6985,"hash":6986,"mime":87,"name":6987,"path":8,"size":6988,"width":411,"height":52,"provider_metadata":6989},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_intro_1_bcf57cdf11/public","thumbnail_intro_1_bcf57cdf11","thumbnail_intro_1.jpg",5.48,{"public_id":6986,"resource_type":6986},"intro_1_bcf57cdf11",123.31,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/intro_1_bcf57cdf11/public",{"public_id":6990,"resource_type":6994},"optimized-intro_1_bcf57cdf11","2026-07-26T20:58:20.427Z",{"data":6997},{"id":242,"attributes":6998},{"name":6999,"createdAt":7000,"updatedAt":7001,"publishedAt":7002},"Sunset Bar","2024-03-