andUrl":8,"highlight":133,"image":1564,"type":1600,"portals":1603,"artist":1606,"series":1610},"2026-02-26T23:00:00.000Z","Ibiza Chillout Mix VII","cafe-del-mar-ibiza-chillout-mix-vii",[1508,1510,1513,1516,1519,1522,1525,1528,1531,1534,1536,1539,1542,1545,1548,1550,1552,1554,1557],{"title":1509,"artist":718},"The Floating Sun",{"title":1511,"artist":1512},"Tupambane","12tree, Miss Vivandra",{"title":1514,"artist":1515},"Oblivion","A Vision of Panorama, Meora",{"title":1517,"artist":1518},"Yukon","BetejayMadelt",{"title":1520,"artist":1521},"Grootman Groove","Young Ginger, BONXNI, SpheCial",{"title":1523,"artist":1524},"Fly Away","Tech Support, Asa Tate",{"title":1526,"artist":1527},"Sueños Soleados","John Beltran",{"title":1529,"artist":1530},"Prevail - Prelude","Ethiopian Chyld",{"title":1532,"artist":1533},"I Still Miss you - Café del Mar Edit","Roque, Mzansi Soulful Ones, Café del Mar",{"title":718,"artist":1535},"Faunabeats, Café del Mar, Gelka",{"title":1537,"artist":1538},"Fraude","Mark Moon",{"title":1540,"artist":1541},"Dreamer","Pig&Dan, Café del Mar",{"title":1543,"artist":1544},"Spare a Minute","Meltonix",{"title":1546,"artist":1547},"Second Vision","Pour Deux",{"title":1549,"artist":1432},"60 Seconds",{"title":1551,"artist":1435},"Us Humans",{"title":1553,"artist":1076},"The Calling - Freeman Remix",{"title":1555,"artist":1556},"Body Language","Jamie Myerson",{"title":1558,"artist":1559},"Platform","Visions of Light","The latest Café del Mar Chillout Mix offers a carefully curated journey into the sound of the White Isle. By seamlessly blending Downtempo and Amapiano with the organic touch of classical guitar and piano, this edition captures the eccentric, shifting atmoshphere of an Ibiza sunset session.\n\nFeaturing 19 artists, the selection brings together ambient pioneers John Beltran, Jamie Myerson, and Pressure Drop alongside longtime Café del Mar collaborators like Pig&Dan, A Vision of Panorama, Gelka, and Andrea Terrano. The mix also introduces newcomers Ethiopian Chyld, Pour Deux, and Vision of Light, including exclusive Café del Mar title track, \"The Floating Sun.\"","2026-02-27T14:08:28.280Z","2026-03-06T20:23:59.405Z","2026-02-27T14:08:31.034Z",{"data":1565},{"id":1566,"attributes":1567},289,{"name":1568,"alternativeText":8,"caption":8,"width":1445,"height":1445,"formats":1569,"hash":1594,"ext":84,"mime":87,"size":1595,"url":1596,"previewUrl":8,"provider":57,"provider_metadata":1597,"createdAt":1599,"updatedAt":1599},"VII-final.jpg",{"large":1570,"small":1576,"medium":1582,"thumbnail":1588},{"ext":84,"url":1571,"hash":1572,"mime":87,"name":1573,"path":8,"size":1574,"width":28,"height":28,"provider_metadata":1575},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_VII_final_3d55e1359c/public","large_VII_final_3d55e1359c","large_VII-final.jpg",68.2,{"public_id":1572,"resource_type":1572},{"ext":84,"url":1577,"hash":1578,"mime":87,"name":1579,"path":8,"size":1580,"width":36,"height":36,"provider_metadata":1581},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_VII_final_3d55e1359c/public","small_VII_final_3d55e1359c","small_VII-final.jpg",22.56,{"public_id":1578,"resource_type":1578},{"ext":84,"url":1583,"hash":1584,"mime":87,"name":1585,"path":8,"size":1586,"width":44,"height":44,"provider_metadata":1587},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_VII_final_3d55e1359c/public","medium_VII_final_3d55e1359c","medium_VII-final.jpg",43.1,{"public_id":1584,"resource_type":1584},{"ext":84,"url":1589,"hash":1590,"mime":87,"name":1591,"path":8,"size":1592,"width":52,"height":52,"provider_metadata":1593},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_VII_final_3d55e1359c/public","thumbnail_VII_final_3d55e1359c","thumbnail_VII-final.jpg",3.94,{"public_id":1590,"resource_type":1590},"VII_final_3d55e1359c",265.93,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/VII_final_3d55e1359c/public",{"public_id":1594,"resource_type":1598},"optimized-VII_final_3d55e1359c","2026-02-27T13:53: