1998 by childhood friends Julius Waters and Mark Blackburn, the duo made their mark with a simple setup; a guitar, synth, sampler, and a knack for warm, timeless melodies. Their debut album Soundphiles put them on the map, and the music eventually found a natural home on Café del Mar compilations.","2026-07-18T17:05:47.764Z","2026-07-27T00:55:49.016Z","2026-07-18T17:05:49.354Z","kinobe",{"data":5330},{"id":5331,"attributes":5332},323,{"name":5333,"alternativeText":8,"caption":8,"width":4817,"height":4817,"formats":5334,"hash":5358,"ext":1722,"mime":87,"size":5359,"url":5360,"previewUrl":8,"provider":57,"provider_metadata":5361,"createdAt":5363,"updatedAt":5363},"ab6761610000f178ee7925a3e1c871ea95050aa8.jfif",{"large":5335,"small":5341,"medium":5347,"thumbnail":5353},{"ext":1722,"url":5336,"hash":5337,"mime":87,"name":5338,"path":8,"size":5339,"width":28,"height":28,"provider_metadata":5340},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_ab6761610000f178ee7925a3e1c871ea95050aa8_bed8641578/public","large_ab6761610000f178ee7925a3e1c871ea95050aa8_bed8641578","large_ab6761610000f178ee7925a3e1c871ea95050aa8.jfif",24.62,{"public_id":5337,"resource_type":5337},{"ext":1722,"url":5342,"hash":5343,"mime":87,"name":5344,"path":8,"size":5345,"width":36,"height":36,"provider_metadata":5346},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_ab6761610000f178ee7925a3e1c871ea95050aa8_bed8641578/public","small_ab6761610000f178ee7925a3e1c871ea95050aa8_bed8641578","small_ab6761610000f178ee7925a3e1c871ea95050aa8.jfif",9.09,{"public_id":5343,"resource_type":5343},{"ext":1722,"url":5348,"hash":5349,"mime":87,"name":5350,"path":8,"size":5351,"width":44,"height":44,"provider_metadata":5352},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_ab6761610000f178ee7925a3e1c871ea95050aa8_bed8641578/public","medium_ab6761610000f178ee7925a3e1c871ea95050aa8_bed8641578","medium_ab6761610000f178ee7925a3e1c871ea95050aa8.jfif",16.19,{"public_id":5349,"resource_type":5349},{"ext":1722,