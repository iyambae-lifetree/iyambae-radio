--box-shadow-elevated:rgba(0,0,0,.25) 0px 14px 36px 0px;--box-shadow:0 8px 13px rgba(0,0,0,.15);--border-radius:18px}.light-mode{--text-primary:#172045;--bg-primary:#f2ede4;--color-primary:#f2ede4;--primary-color:#172045;--color-secondary:#172045;--secondary-color:#f2ede4;--blue:#172045;--light-blue:#172045;--blue-dark:#172045;--highlight:#00000017}.dark-mode{--text-primary:#fff;--color-primary:#172045;--primary-color:#fffbf4;--secondary-color:#172045;--color-secondary:#fffbf4;--bg-primary:#172045;--blue:#172045;--light-blue:#172045;--blue-dark:#172045;--highlight:#ffffff17}body,html{background-color:var(--bg-primary);color:var(--text-primary);font-family:Poppins,"Poppins Fallback: Arial",sans-serif;height:100%;margin:0;overflow-x:clip;padding:0;scroll-behavior:smooth}.tippy-box [data-theme~=light]{background-color:var(--blue-dark,#1e2a48);border-radius:var(--border-radius);box-shadow:var(--box-shadow-elevated);color:#fff;font-size:13px;padding:6px 10px}.tippy-box[data-theme~=rounded] .tippy-arrow{display:none}.venue-tooltip-list{font-size:16px;font-weight:600;list-style:none;margin:0;padding:12px 6px;text-decoration:none!important}.venue-tooltip-list li{margin-bottom:8px}.venue-tooltip-list li a{text-decoration:none;transition:color .3s ease}.sub-text{font-size:16px;font-weight:600;line-height:16px;text-transform:none}.venue-tooltip-list li a:hover{text-decoration:underline}body,button,input,textarea{font-family:Poppins,"Poppins Fallback: Arial",sans-serif}picture{height:100%;width:100%}h4.type{background:var(--blue-dark);border-radius:20px;color:var(--white);font-size:12px;font-weight:600;left:10px;letter-spacing:1px;margin-bottom:10px;padding:5px 10px;text-transform:uppercase;top:10px;width:-moz-fit-content;width:fit-content;z-index:1}.button:hover{text-decoration:none}.tool-bar{align-items:center;display:flex;justify-content:space-between;max-width:800px}.more{border:1.5px solid var(--color-secondary);border-radius:999px;display:inline-flex;font-size:13px;gap:10px;letter-spacing:1px;overflow:hidden;padding:14px 28px;transition:all .3s cubic-bezier(.4,0,.2,1)}.hero-more,.more{align-items:center;color:var(--text-primary);cursor:pointer;font-weight:600;justify-content:center;outline:none;position:relative;text-decoration:none;text-transform:uppercase;width:-moz-fit-content;width:fit-content}.hero-more{backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid var(--color-secondary);border-radius:100px;display:flex;font-size:.75rem;letter-spacing:2px;line-height:normal;margin-top:50px;padding-block:16px;padding-inline:20px;transform:scale(1);transition:all .3s ease-in-out}.hero-more:hover{transform:scale(1.08)}.more:hover{background-color:var(--color-secondary);color:var(--color-primary)}.arrow{display:inline-block;font-size:18px;font-weight:400;height:18px;line-height:1;-o-object-fit:contain;object-fit:contain;transition:transform .3s cubic-bezier(.4,0,.2,1);width:18px}.more:hover .arrow{transform:translate(6px)}.status{backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);background:var(--blue-dark);border-radius:20px;color:#fff;font-size:12px;font-weight:700;left:15px;letter-spacing:.05rem;line-height:.8rem;padding:10px 12px;position:absolute;text-transform:uppercase;top:15px;z-index:9}.dark-mode body{background-color:var(--blue);color:var(--white)}.dark{background-color:var(--bg-secondary)}.hero-subtitle{color:#fff;font-size:.8rem;font-weight:500;letter-spacing:5px;line-height:20px;margin-bottom:1rem;text-transform:uppercase}.page-header{display:flex;justify-content:center;margin-top:25px;padding:4rem 1.5rem}.menu-header{align-items:center;display:flex;flex-direction:column;gap:2rem;max-width:95vw;text-align:center;width:100%}.menu-title{color:var(--color-secondary);font-size:clamp(2rem,5vw,3.5rem);font-weight:700;letter-spacing:.02em;margin:0;text-transform:uppercase}p.centered.hero.description{color:var(--text-primary);font-size:clamp(1rem,2vw,1.25rem);font-weight:400;letter-spacing:.5px;line-height:1.6;max-width:600px}.cards-grid{display:grid;flex-wrap:wrap;grid-template-columns:repeat(auto-fit,minmax(350px,1fr));transition:max-height .5s ease-in-out}.header{font-size:30px;margin-top:20px;text-transform:uppercase}.cta-button{align-items:center;border:1.5px solid var(--color-secondary);border-radius:var(--border-radius);display:inline-flex;font-size:.8rem;font-weight:500;gap:10px;letter-spacing:1.5px;padding:10px 14px;position:relative;text-decoration:none;transition:all .3s cubic-bezier(.4,0,.2,1)}.cta-button.primary{background:transparent;color:var(--text-primary)}.cta-button.primary:hover{background:var(--text-primary);box-shadow:0 8px 16px #0000001a;color:var(--bg-primary);transform:translateY(-1px)}.cta-button.secondary{background:transparent;color:var(--text-primary)}.cta-button.secondary:hover{background:var(--text-primary);box-shadow:0 8px 16px #0000001a;color:var(--bg-primary);transform:translateY(-1px)}.cta-button .arrow{display:inline-block;font-size:1.1em;font-weight:400;transition:transform .3s ease}.cta-button:hover .arrow{transform:translate(3px)}@keyframes floatingAnimation{0%{transform:scale(1)}50%{transform:scale(1.1)}to{transform:scale(1)}}.sunset-cam:hover{border:1px solid #fff}html{scroll-behavior:smooth}.hero-bar{max-width:600px}.lazyload,.lazyloading{opacity:0}.lazyloaded{opacity:1;transition:opacity .3s}.background-panel{background:var(--blue-dark);border-radius:100px}.category{background-color:var(--blue-dark);font-size:12px;left:10px;letter-spacing:1px;margin-bottom:20px;padding:5px 10px;position:absolute;top:10px;z-index:1}.category,.tab{border-radius:20px;color:var(--white);font-weight:600;text-transform:uppercase}.tab{background:var(--blue-dark);cursor:pointer;font-size:14px;margin:5px;padding:10px 20px;transition:all .2s ease-in-out}.tab.active,.tab:hover{background:var(--white);color:var(--blue)}.tabs{align-items:center;gap:10px;margin:10px}.skeleton{animation:loading 1.5s infinite;background:linear-gradient(90deg,#2e355a 25%