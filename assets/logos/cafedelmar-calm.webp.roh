xt":84,"url":10290,"hash":10291,"mime":87,"name":10246,"path":8,"size":10247,"width":6488,"height":52,"provider_metadata":10292},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_68384ca8cfeedbf96630707c_Restaurant_2_31b1fcec13/public","thumbnail_68384ca8cfeedbf96630707c_Restaurant_2_31b1fcec13",{"public_id":10291,"resource_type":10291},"68384ca8cfeedbf96630707c_Restaurant_2_31b1fcec13","https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/68384ca8cfeedbf96630707c_Restaurant_2_31b1fcec13/public",{"public_id":10293,"resource_type":10296},"optimized-68384ca8cfeedbf96630707c_Restaurant_2_31b1fcec13","2025-06-01T14:55:01.614Z",[10299],{"id":6,"weekDay":7061,"HoursOpens":9945,"HoursCloses":7063},[],[],[],{"id":242,"windSpeed":10304,"windDeg":8,"sunsetTime":10305,"sunriseTime":10306,"temperature":10307},2.06,"20:57","07:29","23",{"data":8},[],{"data":8},{"data":10312},[],{"id":242,"attributes":10314},{"name":10315,"description":10316,"videoUrl":8,"about":8,"slug":10317,"createdAt":10318,"updatedAt":10319,"publishedAt":10320,"heroVideoUrl":8,"availableDate":10321,"locale":6956,"image":10322,"type":10359,"address":10362,"essentials":10372,"hours":10377,"spotlight":10378,"faq":10379,"reservationArea":10380,"sectionImages":8,"weather":10381,"video":10386,"stories":10387,"gallery":10388,"localizations":10389},"Malta","Café del Mar Malta offers a magnificent panoramic view of the Mediterranean Sea and the Maltese archipelago of St Paul’s islands, Comino and Gozo. \n\nAt our beach club, we offer a variety of amenities to make your visit as enjoyable as possible. Our on-site restaurant serves delicious Mediterranean-inspired cuisine, and our bar offers a wide selection of cocktails, wines, and beers. We also have a swimming pool, sun loungers, and VIP sofas available for our guests.\n\nIn addition to our amenities, we also offer a variety of activities and entertainment throughout the day. From yoga classes and poolside parties to live music and DJ sets by international superstars, there's always something going on.\n\nSo come join us and experience the magic of Cafe del Mar Malta Beach Club. We look forward to seeing you soon!","malta","2025-05-19T16:11:53.862Z","2025-09-16T20:44:27.633Z","2025-05-19T16:11:56.347Z","2025-05-18T22:00:00.000Z",{"data":10323},{"id":10324,"attributes":10325},272,{"name":10326,"alternativeText":8,"caption":8,"width":80,"height":10327,"formats":10328,"hash":10353,"ext":9168,"mime":87,"size":10354,"url":10355,"previewUrl":8,"provider":57,"provider_metadata":10356,"createdAt":10358,"updatedAt":10358},"Cafe+Del+Mar+Wide+Shots+2nd+May+2025+(95) (1).JPG",2662,{"large":10329,"small":10335,"medium":10341,"thumbnail":10347},{"ext":9168,"url":10330,"hash":10331,"mime":87,"name":10332,"path":8,"size":10333,"width":28,"height":7407,"provider_metadata":10334},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b/public","large_Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b","large_Cafe+Del+Mar+Wide+Shots+2nd+May+2025+(95) (1).JPG",105.54,{"public_id":10331,"resource_type":10331},{"ext":9168,"url":10336,"hash":10337,"mime":87,"name":10338,"path":8,"size":10339,"width":36,"height":37,"provider_metadata":10340},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b/public","small_Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b","small_Cafe+Del+Mar+Wide+Shots+2nd+May+2025+(95) (1).JPG",31.14,{"public_id":10337,"resource_type":10337},{"ext":9168,"url":10342,"hash":10343,"mime":87,"name":10344,"path":8,"size":10345,"width":44,"height":9477,"provider_metadata":10346},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/medium_Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b/public","medium_Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b","medium_Cafe+Del+Mar+Wide+Shots+2nd+May+2025+(95) (1).JPG",62.66,{"public_id":10343,"resource_type":10343},{"ext":9168,"url":10348,"hash":10349,"mime":87,"name":10350,"path":8,"size":10351,"width":6488,"height":52,"provider_metadata":10352},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/thumbnail_Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b/public","thumbnail_Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b","thumbnail_Cafe+Del+Mar+Wide+Shots+2nd+May+2025+(95) (1).JPG",8.99,{"public_id":10349,"resource_type":10349},"Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b",1523.26,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b/public",{"public_id":10353,"resource_type":10357},"optimized-Cafe_Del_Mar_Wide_Shots_2nd_May_2025_95_1_74325b7e9b","2025-09-16T20:44:16.565Z",{"data":10360},{"id":6,"attributes":10361},{"name":9895,"createdAt":9896,"updatedAt":9897,"publishedAt":9898},{"id":66,"street":10363,"phone":10364,"email":10365,"postal":8,"country":10315,"city":10366,"latitude":10367,"longitude":10368,"instagram":10369,"facebook":10370,"website":10371},"Qawra, San Pawl il-Bahar","+356 2258 8100","reservations@cafedelmar.com.mt","Triq it-Trunciera","35.958804","14.3411691","cafedelmarmalta","CafeDelMarMalta","https://cafedelmar.com.mt",{"id":242,"seasonStart":10373,"seasonEnd":10374,"reservationUrl":10375,"image":10376},"2025-04-22T22:00:00.000Z","2025-10-06T22:00:00.000Z","https://cafedelmar.com.mt/sunbeds/",{"data":8},[],[],[],[],{"id":66,"windSpeed":10382,"windDeg":8,"sunsetTime":10383,"sunriseTime":10384,"temperature":10385},1.03,"18:46","06:19","26",{"data":8},[],{"data":8},{"data":10390},[],{"id":188,"attributes":10392},{"name":10393,"description":10394,"videoUrl":8,"about":8,"slug":10395,"createdAt":10396,"updatedAt":10397,"publishedAt":10398,"heroVideoUrl":8,"availableDate":10399,"locale":6956,"image":10400,"type":10437,"address":10444,"essentials":10453,"hours":10456,"spotlight":10457,"faq":10458,"reservationArea":10459,"sectionImages":8,"weather":10460,"video":10464,"stories":10465,"gallery":10466,"localizations":10467},"Tarifa","Located right on the seafront of the charming town of Tarifa, known as the \"wind capital of water sports,\" Café del Mar Beach is the perfect venue for organizing all types of events.\n\nAt our restaurant, savor Mediterranean and local cuisines, or enjoy a drink at our Cocktail Bar, which offers a variety of cocktails in a friendly atmosphere. Come and indulge in a unique gastronomic experience with a menu specially prepared for you.\n\nCafé del Mar in Tarifa captures the essence and atmosphere of its namesake in a distinctive setting along the shores of Los Lances beach.\n\nWe specialize in breakfasts, lunches, dinners, and cocktails that are sure to entice you. Renowned for its live performances and spectacular views of the sea and sunsets, our venue promises unforgettable experiences.\n\nWe are confident that our new 'restobar' concept will charm you. Visit us once, and you'll find yourself returning again and again! We look forward to welcoming you","tarifa","2025-05-19T16:15:30.398Z","2025-08-01T21:52:22.657Z","2025-05-19T16:15:32.789Z","2025-05-06T22:00:00.000Z",{"data":10401},{"id":10402,"attributes":10403},189,{"name":10404,"alternativeText":8,"caption":8,"width":18,"height":10405,"formats":10406,"hash":10431,"ext":84,"mime":87,"size":10432,"url":10433,"previewUrl":8,"provider":57,"provider_metadata":10434,"createdAt":10436,"updatedAt":10436},"1ac3c351e2c4fd6c8f0b9a431b34299a_77cd218ef5.jpg",1366,{"large":10407,"small":10413,"medium":10419,"thumbnail":10425},{"ext":84,"url":10408,"hash":10409,"mime":87,"name":10410,"path":8,"size":10411,"width":28,"height":29,"provider_metadata":10412},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_1ac3c351e2c4fd6c8f0b9a431b34299a_77cd218ef5_72720f0824/public","large_1ac3c351e2c4fd6c8f0b9a431b34299a_77cd218ef5_72720f0824","large_1ac3c351e2c4fd6c8f0b9a431b34299a_77cd218ef5.jpg",178.86,{"public_id":10409,"resource_type":10409},{"ext":84,"url":10414,"hash":10415,"mime":87,"name":10416,"path":8,"size":10417,"width":36,"height":37,"provider_metad