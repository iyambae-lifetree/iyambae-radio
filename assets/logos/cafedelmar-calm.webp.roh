76.28,"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/s_l1600_a663dcc3eb/public",{"public_id":4552,"resource_type":4556},"optimized-s_l1600_a663dcc3eb","2025-07-21T09:15:23.645Z",{"data":4559},{"id":188,"attributes":4560},{"name":3143,"createdAt":3144,"updatedAt":3145,"publishedAt":3146},{"data":4562},{"id":6,"attributes":4563},{"name":1069,"bio":8,"pressPhotos":8,"createdAt":4469,"updatedAt":4470,"publishedAt":4471,"slug":8,"image":4564,"socials":8},{"data":8},{"data":4566},{"id":242,"attributes":4567},{"name":3157,"createdAt":3158,"updatedAt":3159,"publishedAt":3160},{"id":4569,"attributes":4570},84,{"availableDate":4571,"name":4572,"lenght":8,"slug":4573,"spotifyId":8,"metadata":4574,"appOnly":8,"memberOnly":8,"audioUrl":8,"releaseDate":4604,"featured":133,"status":8,"linkUrl":8,"description":4605,"createdAt":4606,"updatedAt":4607,"publishedAt":4608,"onDemand":133,"onDemandUrl":4609,"highlight":8,"image":4610,"type":4652,"portals":8,"artist":4655,"series":4659},"1997-06-14T10:00:00.000Z","Volumen Cuatro (Vol. 4)","cafe-del-mar-volumen-cuatro",[4575,4578,4580,4582,4584,4586,4588,4591,4593,4594,4595,4596,4598,4601],{"title":4576,"artist":4577},"Que Bonito","Jose Padilla",{"title":4579,"artist":516},"Sunshines Better (Talvin Singh)",{"title":862,"artist":4581},"Indo-Aminata",{"title":4583,"artist":4411},"Grillos",{"title":694,"artist":4585},"Voices Of Kwahn A.D.",{"title":4587,"artist":829},"Miracle Road",{"title":4589,"artist":4590},"No Sant (Flytronix Mix)","Wasis Diop Featuring Lena Fiagbe",{"title":4592,"artist":540},"Out Of Time",{"title":4061,"artist":1650},{"title":856,"artist":857},{"title":793,"artist":757},{"title":4597,"artist":548},"Troubled Girl (Spanish Version)",{"title":4599,"artist":4600},"Lula","Phil Mison",{"title":4602,"artist":4603},"Street Tattoo","Stan Getz","1997-06-13T22:00:00.000Z","Compiled with love by José Padilla\n\nIf you sit outside Café del Mar on a summer evening (as tens of thousands have) you can watch the sun set directly between two big rocks out at sea. The dying rays of the sun gradually fade, colouring the rocks pink before finally retreating beyond the horizon.\n\nA perfect end to a perfect day, not to mention the perfect start to another night of Ibizan excess as clubbers from all over Europe congregate and plan the night ahead. For years regulars asked the café’s resident DJ José to make them tapes of his hand-picked, chilled out and totally eclectic tunes. As he himself says “I am always trying to find tracks which would otherwise be forgotten, or which hold the spirit of Café del Mar.”\n\nThe demand became so great that the natural progression was to put together the annual compilation. This is the fourth such compilation, still evoking the mood of the Café del Mar and still selected by José to “let your mind roll free to the rhythms of the sea,” as he put it.\n\nSo roll with it.","2025-06-22T11:20:11.568Z","2026-08-17T10:31:41.649Z","2025-07-21T09:09:50.755Z","https://soundcloud.com/cafedelmarmusic/cafe-del-mar-ibiza-volumen-cuatro",{"data":4611},{"id":4612,"attributes":4613},227,{"name":4614,"alternativeText":8,"caption":8,"width":4615,"height":4616,"formats":4617,"hash":4646,"ext":84,"mime":87,"size":4647,"url":4648,"previewUrl":8,"provider":57,"provider_metadata":4649,"createdAt":4651,"updatedAt":4651},"cdmcuatro.jpg",909,821,{"large":4618,"small":4625,"medium":4632,"thumbnail":4639},{"ext":84,"url":4619,"hash":4620,"mime":87,"name":4621,"path":8,"size":4622,"width":28,"height":4623,"provider_metadata":4624},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/large_cdmcuatro_0dadaf4b8e/public","large_cdmcuatro_0dadaf4b8e","large_cdmcuatro.jpg",200.04,903,{"public_id":4620,"resource_type":4620},{"ext":84,"url":4626,"hash":4627,"mime":87,"name":4628,"path":8,"size":4629,"width":36,"height":4630,"provider_metadata":4631},"https://imagedelivery.net/gWm-cErGDmEnDn2Z5pH7Pw/small_cdmcuatro_0dadaf4b8e/public","small_cdmcuatro_0dadaf4b8e","small_cdmcuatro.jpg",47.36,452,{"public_id":462